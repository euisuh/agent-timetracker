# Example only. Copy to .env.agents, which must never be committed.
TIMETRACKER_BASE_URL=https://time-api.example.com

# PROFILE "model" -> suffix MODEL
TIMETRACKER_USER_MODEL=agent-model
TIMETRACKER_TOKEN_MODEL=

# Required only when TIMETRACKER_BASE_URL is protected by Cloudflare Access.
TIMETRACKER_CF_ACCESS_CLIENT_ID=
TIMETRACKER_CF_ACCESS_CLIENT_SECRET=
